---
import { socialLinks } from '../data/site';
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div>
      <p>© 2026 Chen-Ling Lin</p>
      <p class="small muted">Built with Astro · I want to see how far I can go.</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      {socialLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>
