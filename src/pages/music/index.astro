---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComingSoon from '../../components/ComingSoon.astro';
const page = await getEntry('pages', 'music');
if (!page) throw new Error('Missing page content: music');
const { Content } = await render(page);
const data = page.data;
---
<BaseLayout title={data.title} description={data.description}>
  <header class="page-hero shell"><p class="eyebrow">{data.eyebrow}</p><h1>{data.heading}</h1><p class="lede">{data.lede}</p></header>
  <section class="section music-band"><div class="shell page-grid"><article class="prose" lang="zh-Hant"><Content /></article><aside><p class="eyebrow">Upcoming Performances</p><div class="performance-list">{data.performances.map((performance: { date: string; name: string; detail: string }) => <div class="performance"><span class="small muted">{performance.date}</span><div>{performance.name}<br /><span class="muted">{performance.detail}</span></div></div>)}</div></aside></div></section>
  <section class="section"><div class="shell content-index">{data.sections.map((section: string) => <section class="index-section"><h2>{section}</h2><ComingSoon compact /></section>)}</div></section>
</BaseLayout>
