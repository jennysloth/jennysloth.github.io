---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const page = await getEntry('pages', 'privacy');
if (!page) throw new Error('Missing page content: privacy');
const { Content } = await render(page);
const data = page.data;
---
<BaseLayout title={data.title} description={data.description}><header class="page-hero shell"><p class="eyebrow">{data.eyebrow}</p><h1>{data.heading}</h1><p class="lede">{data.lede}</p></header><section class="section section-soft"><article class="shell narrow prose"><Content /></article></section></BaseLayout>
