---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComingSoon from '../../components/ComingSoon.astro';
const page = await getEntry('pages', 'resume');
if (!page) throw new Error('Missing page content: resume');
const data = page.data;
---
<BaseLayout title={data.title} description={data.description}><header class="page-hero shell"><p class="eyebrow">{data.eyebrow}</p><h1>{data.heading}</h1><p class="lede">{data.lede}</p></header><section class="section section-soft"><div class="shell narrow"><ComingSoon /><p><a class="text-link" href="mailto:linchenling233@gmail.com">{data.contactLabel}</a></p></div></section></BaseLayout>
