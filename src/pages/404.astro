---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex><section class="not-found"><div class="shell not-found-inner"><div class="not-found-mark" aria-hidden="true">🦥</div><h1>Page not found.</h1><p class="lede" style="margin:18px auto 0">This page may have moved, or perhaps it was never here.</p><div class="not-found-actions"><a class="button-link" href="/">Back Home</a><button class="button-link" style="border:0;cursor:pointer" type="button" data-search-open>Search the Site</button></div></div></section></BaseLayout>
