---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing page content: about');
const { Content } = await render(page);
const data = page.data;
---
<BaseLayout title={data.title} description={data.description}>
  <header class="page-hero shell"><p class="eyebrow">{data.eyebrow}</p><h1>{data.heading}</h1><p class="lede">{data.lede}</p></header>
  <section class="section section-soft"><div class="shell page-grid">
    <article class="prose" lang="zh-Hant"><Content /></article>
    <aside><p class="eyebrow">Quick Facts</p><div class="facts">{data.facts.map((fact: { label: string; value: string }) => <div class="fact"><span class="small muted">{fact.label}</span><span style="white-space:pre-line">{fact.value}</span></div>)}</div><p class="eyebrow" style="margin-top:42px">Current Focus</p><p>{data.currentFocus}</p><p><a class="text-link" href="/resume/">Resume</a> · <a class="text-link" href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=linchenling233@gmail.com" target="_blank" rel="noopener noreferrer">Contact</a></p></aside>
  </div></section>
</BaseLayout>
