---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComingSoon from '../../components/ComingSoon.astro';
---
<BaseLayout title="Notes" description="Coursework, mathematics, data, code, and polished study notes.">
  <header class="page-hero shell"><p class="eyebrow">Knowledge Archive</p><h1>Notes</h1><p class="lede">整理完成的課程紀錄、數學觀念、資料與程式筆記。中文正文為主，並附英文摘要。</p></header>
  <section class="section section-soft"><div class="shell content-index">
    <section class="index-section"><h2>Coursework</h2><div class="rule-list"><article class="rule-row"><p class="eyebrow">Junior Year · Fall 2026</p><h3><a href="/notes/coursework/">Coursework Overview</a></h3><p class="muted">Applied Mathematics, MIS, and Entrepreneurship.</p></article></div></section>
    <section class="index-section"><h2>Mathematics</h2><ComingSoon compact /></section>
    <section class="index-section"><h2>Data & Code</h2><ComingSoon compact /></section>
    <section class="index-section"><h2>Study Notes</h2><ComingSoon compact /></section>
    <section class="index-section"><h2>Archive</h2><ComingSoon compact /></section>
  </div></section>
</BaseLayout>
