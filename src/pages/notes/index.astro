---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComingSoon from '../../components/ComingSoon.astro';
const page = await getEntry('pages', 'notes');
if (!page) throw new Error('Missing page content: notes');
const data = page.data;
---
<BaseLayout title={data.title} description={data.description}>
  <header class="page-hero shell"><p class="eyebrow">{data.eyebrow}</p><h1>{data.heading}</h1><p class="lede">{data.lede}</p></header>
  <section class="section section-soft"><div class="shell content-index"><section class="index-section"><h2>Coursework</h2><div class="rule-list">{data.coursework.map((semester: { year: string; semester: string; href?: string }) => <article class="rule-row"><p class="eyebrow">{semester.year}</p><h3>{semester.href ? <a href={semester.href}>{semester.semester}</a> : semester.semester}</h3>{!semester.href && <span class="small muted">Coming Soon</span>}</article>)}</div></section>{data.sections.map((section: string) => <section class="index-section"><h2>{section}</h2><ComingSoon compact /></section>)}</div></section>
</BaseLayout>
