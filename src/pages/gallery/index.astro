---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { galleryAlbums } from '../../data/gallery';
---
<BaseLayout title="Gallery" description="Public albums and visual stories by Chen-Ling Lin.">
  <header class="page-hero shell"><p class="eyebrow">Photography</p><h1>Gallery</h1><p class="lede">Public albums shaped as visual journals.</p></header>
  <section class="section section-soft">
    <div class="shell album-grid">
      {galleryAlbums.map((album) => (
        <article class="album-card">
          <a href={`/gallery/${album.slug}/`} aria-label={`View ${album.title}`}>
            {album.cover ? (
              <img src={album.cover} alt="" loading="lazy" />
            ) : (
              <div class="album-placeholder" aria-hidden="true"><span>{album.date}</span></div>
            )}
            <div class="album-card-copy">
              <p class="eyebrow">{album.category}</p>
              <h2>{album.title}</h2>
              <p>{album.description}</p>
              {album.location && <p class="small muted">{album.location}</p>}
              <span class="text-link small">{album.photos.length ? `${album.photos.length} photos` : 'Album ready for photos'}</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
  <section class="section"><div class="shell"><div class="section-header"><h2>Browse Albums</h2></div><nav class="category-links"><a href="/categories/life/">Life</a><a href="/categories/travel/">Travel</a><a href="/categories/music/">Music</a><a href="/categories/photography/">Photography</a><a href="/categories/events/">Events</a></nav></div></section>
</BaseLayout>
